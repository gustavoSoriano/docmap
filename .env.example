# Rede local (tablet desenha no /canvas pelo browser).
# Default: 127.0.0.1 (somente esta máquina).
# Use 0.0.0.0 apenas quando quiser expor /canvas na rede local.
DOCMAP_HOST=

# Desenvolvimento: encerra processos ocupando as portas 3333/3334/3335 antes
# do boot. Deixe vazio em uso normal.
DOCMAP_KILL_PORTS=

# Repositório usado pelo auto-update (opcional).
DOCMAP_REPO=gustavosoriano/docmap

# Caminhos opcionais para as dependências de podcasts.
DOCMAP_EDGE_TTS=
DOCMAP_FFMPEG=
DOCMAP_FFPROBE=
